# Base URL of the Go API the SvelteKit BFF proxies to (server-only).
BACKEND_URL=http://localhost:8080

# Lifetime of the session cookie in seconds (server-only). Keep it at least as
# long as the Go API's POS_SESSION_TTL — a cookie that dies first logs the
# terminal out early. Default: 43200 (12 hours).
SESSION_MAX_AGE_SECONDS=43200
